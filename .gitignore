# Shared ignores for the whole repo.
# TaskFlow_Client/ and TaskFlow_Server/ also have their own .gitignore files.

# Dependencies
node_modules/

# Environment variables
.env
.env.*
!.env.example

# Build outputs
dist/
build/
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
